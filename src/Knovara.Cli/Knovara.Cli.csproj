<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Knovara.Cli</RootNamespace>
    <AssemblyName>knovara</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Only for LocalRuntimeLauncher (starting the installed runtime on demand); the CLI still talks the
         same public HTTP contract any external caller would, with no reference to Knovara.Core. -->
    <ProjectReference Include="..\Knovara.Common\Knovara.Common.csproj" />
  </ItemGroup>

</Project>
