<Window x:Class="Knovara.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Knovara - Connect" Height="420" Width="480"
        MinHeight="360" MinWidth="420"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Background="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Knovara SaaS Desktop" FontSize="20" FontWeight="Bold" Foreground="#1E293B"/>
            <TextBlock Text="Configure connection to Knovara backend" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Input Fields -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <StackPanel Margin="0,0,5,0">
                <TextBlock Text="API Base URL:" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="#475569"/>
                <TextBox x:Name="BaseUrlBox" Text="http://localhost:5299" Margin="0,0,0,12" Padding="6" FontSize="13"/>
                
                <TextBlock Text="Tenant ID:" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="#475569"/>
                <TextBox x:Name="TenantBox" Text="acme" Margin="0,0,0,12" Padding="6" FontSize="13"/>

                <TextBlock Text="JWT Token (optional for dev mode):" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="#475569"/>
                <TextBox x:Name="TokenBox" Margin="0,0,0,8" Padding="6" FontSize="13"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Action Footer (Always anchored at the bottom) -->
        <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Connect" Click="OnLoginClicked" Width="110" Height="34" 
                        Background="#2563EB" Foreground="White" FontWeight="SemiBold" FontSize="13" Cursor="Hand" IsDefault="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
