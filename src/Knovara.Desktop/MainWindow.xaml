<Window x:Class="Knovara.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Knovara Desktop Client" Height="820" Width="1060"
        MinHeight="660" MinWidth="900"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip" Background="#F8FAFC">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Connection Info -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="15,12" Margin="0,0,0,12" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Knovara Desktop" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                    <TextBlock x:Name="ConnectionInfoText" Text="Connecting..." FontSize="12" Foreground="#64748B" Margin="0,3,10,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Disconnect / Switch Tenant" Click="OnDisconnectClicked"
                        Background="#F1F5F9" Foreground="#334155" BorderBrush="#CBD5E1" BorderThickness="1" 
                        Padding="12,6" Cursor="Hand" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Main Workspace Tabs -->
        <TabControl Grid.Row="1" Background="White" BorderBrush="#E2E8F0">
            <!-- TAB 1: ASK WITH CONTEXT DOCUMENTS -->
            <TabItem Header=" Ask (Evidence &amp; Context) " Padding="12,7" FontWeight="SemiBold">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Question & Retrieval Controls -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Question:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,3"/>
                                <TextBox x:Name="AskQuestionBox" Height="28" Padding="4" Text="What is Knovara's architecture?"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Session ID:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,3"/>
                                <TextBox x:Name="AskSessionBox" Height="28" Padding="4" Text="desktop-session-1"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Token Budget:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,3"/>
                                <TextBox x:Name="AskBudgetBox" Height="28" Padding="4" Text="2000" TextChanged="OnBudgetChanged"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Documents in context: attach files/folders (buttons or drag & drop), review, remove, ask -->
                    <Border x:Name="ContextPanel" Grid.Row="1" Background="#F1F5F9" CornerRadius="6" BorderBrush="#CBD5E1" BorderThickness="1" Padding="12" Margin="0,0,0,10"
                            AllowDrop="True" DragEnter="OnContextDragOver" DragOver="OnContextDragOver" DragLeave="OnContextDragLeave" Drop="OnContextDrop">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="📄 Documents in Context" FontWeight="Bold" Foreground="#1E293B" FontSize="13"/>
                                    <TextBlock x:Name="ContextSummaryText" Text="No documents attached" Foreground="#64748B" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="AttachFilesButton" Content="📂 Attach Files..." Click="OnBrowseDocumentClicked" Margin="0,0,6,0"
                                            ToolTip="Pick one or more files; they are attached immediately. You can also drag files here."
                                            Padding="10,4" Background="#E2E8F0" Foreground="#1E293B" BorderBrush="#CBD5E1" Cursor="Hand"/>
                                    <Button x:Name="AttachFolderButton" Content="🗂 Attach Folder..." Click="OnAttachFolderClicked" Margin="0,0,6,0"
                                            ToolTip="Pick a folder; every text file in it and its subfolders (up to 200) is attached. You can also drag a folder here."
                                            Padding="10,4" Background="#E2E8F0" Foreground="#1E293B" BorderBrush="#CBD5E1" Cursor="Hand"/>
                                    <Button x:Name="ClearAllButton" Content="✕ Clear All" Click="OnClearContextDocsClicked"
                                            Padding="10,4" Background="#FEE2E2" Foreground="#991B1B" BorderBrush="#FECACA" Cursor="Hand"/>
                                </StackPanel>
                            </Grid>

                            <!-- Inline feedback instead of blocking dialogs; Undo restores what was just removed -->
                            <Border x:Name="AttachStatusBorder" Visibility="Collapsed" CornerRadius="4" Padding="8,5" Margin="0,0,0,8" Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="AttachStatusText" Grid.Column="0" TextWrapping="Wrap" FontSize="12" Foreground="#14532D" VerticalAlignment="Center"/>
                                    <Button x:Name="UndoButton" Grid.Column="1" Content="Undo" Click="OnUndoClicked" Visibility="Collapsed"
                                            Background="Transparent" Foreground="#1D4ED8" BorderThickness="0" Padding="8,0" Cursor="Hand" FontWeight="SemiBold"/>
                                    <Button Grid.Column="2" Content="✕" Click="OnDismissStatusClicked" ToolTip="Dismiss"
                                            Background="Transparent" Foreground="#475569" BorderThickness="0" Padding="6,0" Cursor="Hand"/>
                                </Grid>
                            </Border>

                            <!-- Attached documents list (empty state doubles as the drop target hint) -->
                            <Grid>
                                <ListBox x:Name="ContextDocsListBox" MinHeight="60" MaxHeight="190" BorderBrush="#CBD5E1" Background="White"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,2" ToolTip="{Binding PreviewText}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="#1E293B" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Location}" FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding TokensText}" FontSize="11" Foreground="#64748B" Margin="8,0" VerticalAlignment="Center"/>
                                                <Button Grid.Column="3" Content="✕" Click="OnRemoveContextDocClicked" Tag="{Binding Id}" ToolTip="Remove from context"
                                                        Background="Transparent" Foreground="#DC2626" BorderThickness="0" Padding="6,1" Cursor="Hand" FontSize="12"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="ContextEmptyHint" Text="Drop files or a folder here, or use the buttons above"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="12" IsHitTestVisible="False"/>
                            </Grid>

                            <!-- Typed notes are the exception, so they stay out of the way until wanted -->
                            <Expander Header="Add a typed note" Margin="0,8,0,0" FontSize="12" Foreground="#334155">
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="NewDocTitleBox" Grid.Column="0" Height="28" Padding="4" Margin="0,0,8,0" ToolTip="Title for the note (optional)"/>
                                    <TextBox x:Name="NewDocContentBox" Grid.Column="1" Height="28" Padding="4" Margin="0,0,8,0" ToolTip="The note's text"/>
                                    <Button Grid.Column="2" Content="+ Add Note" Click="OnAddCustomDocClicked" Height="28"
                                            Background="#3B82F6" Foreground="White" FontWeight="SemiBold" Cursor="Hand"/>
                                </Grid>
                            </Expander>

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button x:Name="AskButton" Content="Ask Knovara (with Context)" Click="OnAskClicked" Height="34" Width="230"
                                        Background="#2563EB" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Results Area -->
                    <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="AskResultBox" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                     TextWrapping="Wrap" FontFamily="Consolas" FontSize="13" Text="Ask results will appear here..."/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: SEARCH -->
            <TabItem Header=" Search " Padding="12,7" FontWeight="SemiBold">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Search Query:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,3"/>
                                <TextBox x:Name="SearchQueryBox" Height="28" Padding="4" Text="vector index pipeline"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <TextBlock Text="Mode:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,3"/>
                                <ComboBox x:Name="SearchModeCombo" Height="28" SelectedIndex="0">
                                    <ComboBoxItem Content="Adaptive" ToolTip="Default: hybrid, escalating to the cross-encoder only when the top results are too close to call."/>
                                    <ComboBoxItem Content="Lexical" ToolTip="Postgres full-text search only."/>
                                    <ComboBoxItem Content="Semantic" ToolTip="Embedding similarity only."/>
                                    <ComboBoxItem Content="Hybrid" ToolTip="Lexical and semantic merged with Reciprocal Rank Fusion."/>
                                    <ComboBoxItem Content="HybridRerank" ToolTip="Hybrid candidates reordered by the cross-encoder (most accurate, slowest)."/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Top K:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,3"/>
                                <TextBox x:Name="SearchTopKBox" Height="28" Padding="4" Text="5"/>
                            </StackPanel>
                        </Grid>

                        <Button Content="Run Search" Click="OnSearchClicked" Height="32" Width="140" HorizontalAlignment="Left"
                                Background="#0284C7" Foreground="White" FontWeight="SemiBold" Cursor="Hand"/>
                    </StackPanel>

                    <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="SearchResultBox" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                     TextWrapping="Wrap" FontFamily="Consolas" FontSize="13" Text="Search results will appear here..."/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: INGEST -->
            <TabItem Header=" Ingest Resource " Padding="12,7" FontWeight="SemiBold">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Resource URI / Path:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,3"/>
                                <TextBox x:Name="IngestUriBox" Height="28" Padding="4" Text="samples/readme.md"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Source Type:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,3"/>
                                <ComboBox x:Name="IngestTypeCombo" Height="28" SelectedIndex="0">
                                    <ComboBoxItem Content="Document"/>
                                    <ComboBoxItem Content="Website"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal">
                            <Button Content="Queue Ingestion" Click="OnIngestClicked" Height="32" Width="150"
                                    Background="#10B981" Foreground="White" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,10,0"/>
                            <Button Content="📤 Upload File..." Click="OnUploadFileClicked" Height="32" Width="150" Margin="0,0,10,0"
                                    ToolTip="Sends a local file (pdf, docx, pptx, html, md, txt) to Knovara and queues it. Use this instead of typing a local path - the worker cannot read your disk."
                                    Background="#0EA5E9" Foreground="White" FontWeight="SemiBold" Cursor="Hand"/>
                            <Button Content="📌 Also Pin to Ask Context" Click="OnPinIngestedToContextClicked" Height="32" Width="190"
                                    Background="#6366F1" Foreground="White" FontWeight="SemiBold" Cursor="Hand"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="IngestResultBox" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                     TextWrapping="Wrap" FontFamily="Consolas" FontSize="13" Text="Ingestion status will appear here..."/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 4: DOCUMENT MANAGEMENT -->
            <TabItem Header=" Documents " Padding="12,7" FontWeight="SemiBold">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📁 Documents for this tenant:" FontWeight="Bold" Foreground="#1E293B" FontSize="13"/>
                            <TextBlock x:Name="DocumentsSummaryText" Text=" loading..." Foreground="#64748B" FontSize="12" Margin="5,1,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="DeleteFailedButton" Content="🧹 Delete Failed" Click="OnDeleteFailedClicked" Margin="0,0,6,0" IsEnabled="False"
                                    ToolTip="Deletes every document whose processing failed. Asks first; cannot be undone."
                                    Padding="10,4" Background="#FEE2E2" Foreground="#991B1B" BorderBrush="#FECACA" Cursor="Hand"/>
                            <Button Content="🔄 Refresh" Click="OnRefreshDocumentsClicked"
                                    ToolTip="Reload the list from the API - only the documents registered for the current tenant."
                                    Padding="10,4" Background="#E2E8F0" Foreground="#1E293B" BorderBrush="#CBD5E1" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10">
                        <ListBox x:Name="DocumentsListBox" BorderThickness="0" Background="Transparent"
                                 HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding DisplayText}" FontSize="13" Foreground="#1E293B" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding ErrorText}" FontSize="11" Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,2,0,0" MaxHeight="48"/>
                                                <TextBlock Text="{Binding ResourceId}" FontSize="10" Foreground="#94A3B8" FontFamily="Consolas" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="↻ Re-ingest" Click="OnReingestDocumentClicked" Tag="{Binding ResourceId}"
                                                        ToolTip="Queue this document for processing again (e.g. to retry a failure or refresh a web page)."
                                                        Background="#E2E8F0" Foreground="#1E293B" BorderBrush="#CBD5E1" Padding="8,3" Margin="0,0,6,0" Cursor="Hand" FontSize="11"/>
                                                <Button Content="🗑 Delete" Click="OnDeleteDocumentClicked" Tag="{Binding ResourceId}"
                                                        ToolTip="Deletes this document and everything extracted from it. Cannot be undone."
                                                        Background="#FEE2E2" Foreground="#991B1B" BorderBrush="#FECACA" Padding="8,3" Cursor="Hand" FontSize="11"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 5: RESOURCE STATUS -->
            <TabItem Header=" Resource Inspector " Padding="12,7" FontWeight="SemiBold">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Resource ID:" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,3"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="160"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="StatusResourceIdBox" Grid.Column="0" Height="28" Padding="4" Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="Check Status" Click="OnCheckStatusClicked" Height="28" Margin="0,0,8,0"
                                    Background="#64748B" Foreground="White" FontWeight="SemiBold" Cursor="Hand"/>
                            <Button Grid.Column="2" Content="📌 Pin to Context" Click="OnPinResourceToContextClicked" Height="28"
                                    Background="#4F46E5" Foreground="White" FontWeight="SemiBold" Cursor="Hand"/>
                        </Grid>
                    </StackPanel>

                    <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="6" BorderBrush="#E2E8F0" BorderThickness="1" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="StatusResultBox" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                                     TextWrapping="Wrap" FontFamily="Consolas" FontSize="13" Text="Resource status details will appear here..."/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" Background="#F1F5F9" CornerRadius="6" Padding="10,6" Margin="0,10,0,0">
            <TextBlock x:Name="BottomStatusText" Text="Ready" FontSize="12" Foreground="#475569"/>
        </Border>
    </Grid>
</Window>
